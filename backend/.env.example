# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# LLM API (Together AI / Groq / OpenAI)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# JWT
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Database
DATABASE_PATH=/mediassist_data/db/mediassist.db

# Embedding (uses Together AI by default — switch to any OpenAI-compatible embeddings provider)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.together.xyz/v1
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large-instruct
EMBEDDING_DEVICE=cpu

# Reranker Model
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
